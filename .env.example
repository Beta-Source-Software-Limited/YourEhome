# Copy this file to .env before running Docker Compose.
MYSQL_DATABASE=yourehome
MYSQL_USER=yourehome
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_root_password
DJANGO_SECRET_KEY=replace-with-a-long-unique-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
API_INTERNAL_URL=http://backend:8000/api
